# Copy to infra/docker/.env and fill in. Never commit the real file.

# Public hostname for automatic HTTPS via Caddy (e.g. decoyr.example.com). ":80" = plain HTTP on any host.
DECOYR_DOMAIN=:80
DECOYR_PUBLIC_URL=http://localhost

# Vultr Serverless Inference (trusted control plane ONLY — never enters a sandbox).
VULTR_SERVERLESS_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Live model id from GET https://api.vultrinference.com/v1/models
DECOYR_MODEL=

# HMAC key for trial tokens + the internal service token. Generate: openssl rand -hex 32
DECOYR_INTERNAL_SIGNING_KEY=change-me
# Postgres password. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Team-only actions (Reset Demo). Generate: openssl rand -hex 16
DECOYR_ADMIN_TOKEN=

DECOYR_HOST_PROVIDER=vultr

# Per-trial sandbox limits
TRIAL_MAX_SECONDS=180
TRIAL_MEMORY_MB=512
TRIAL_CPU_QUOTA=1.0
TRIAL_MAX_PIDS=128
TRIAL_MAX_TOOL_CALLS=40

# Only for building behind a TLS-intercepting proxy: path (inside infra/docker/) to an extra CA bundle
# used by `npm ci` during image builds. Leave unset on Vultr.
# BUILD_CA_FILE=./build-ca.local.pem
